# PayPal sandbox REST app (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Filled in after the webhook is registered
PAYPAL_WEBHOOK_ID=

# Sandbox test accounts (developer.paypal.com -> Testing Tools -> Sandbox Accounts)
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# Anthropic API key for Claude
ANTHROPIC_API_KEY=

# Postgres connection string
DATABASE_URL=

# Public URL of this app (used for webhooks and return URLs)
APP_BASE_URL=http://localhost:3000
