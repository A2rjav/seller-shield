# PayPal sandbox REST app (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Filled in after the webhook is registered
PAYPAL_WEBHOOK_ID=

# Sandbox test accounts (developer.paypal.com -> Testing Tools -> Sandbox Accounts)
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# Google Gemini API key (aistudio.google.com/apikey)
GEMINI_API_KEY=
# Gemini model id. Leave empty: the app lists models once (ListModels) and picks the newest stable "pro"
# (falling back to newest stable "flash"), excluding preview/exp/tts/image/embedding/live/audio ids.
# Pin a value here to override. Resolved id is cached in-process.
GEMINI_MODEL=

# Postgres connection string
DATABASE_URL=

# Public URL of this app (used for webhooks and return URLs)
APP_BASE_URL=http://localhost:3000

# Demo shopper agent Ed25519 private key as a JWK JSON string (generate: npx tsx scripts/gen-agent-key.ts).
# If empty, an ephemeral key is generated per server process, so set it on the hosted demo.
SHOPPER_AGENT_PRIVATE_JWK=
